{
  "name": "dsh-mcp-desktop",
  "version": "0.3.0",
  "description": "MCP bridge for visible, persistent tasks in DeepSeek Harness desktop",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "desktop/bridge.mjs",
    "desktop/web-client.mjs",
    "desktop/server.mjs",
    "desktop/session-plugin.mjs",
    "desktop/install.mjs",
    "desktop/NOTICE.md",
    "desktop/LICENSE.dsh-subagent-mcp",
    "README.upstream.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build && npm test",
    "desktop:install": "node desktop/install.mjs",
    "test:desktop": "node --test desktop/*.test.mjs",
    "smoke:desktop": "node desktop/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2",
    "ws": "^8.22.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5",
    "vitest": "^3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TrivialHe/dsh-mcp-desktop.git"
  }
}
